# Settings of the VPS stack (compose.yaml and its companions). Copy to .env next to compose.yaml:
#   cp deploy/env.example .env
# Settings of the room server itself (retention, limits, Telegram, ...) go in ./server.env instead;
# copy apps/server/.env.example there and keep the lines you change. docs/DOCKER.md explains both.

# Which compose files make up the stack. Separate them with a colon.
COMPOSE_FILE=compose.yaml
#COMPOSE_FILE=compose.yaml:compose.postgres.yaml
#COMPOSE_FILE=compose.yaml:compose.postgres.yaml:compose.monitoring.yaml

# The address of the site. A host name gets a certificate by itself (ports 80 and 443 must reach
# this machine and the name must point at it). ":80" is plain HTTP on any name: for a first test.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Memory ceilings per container. The room server's heap is kept below its ceiling.
SERVER_MEMORY=256m
SERVER_HEAP_MB=192
CADDY_MEMORY=96m

# Only with compose.postgres.yaml. Letters and digits only: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_MEMORY=384m
POSTGRES_SHARED_BUFFERS=128MB

# Only with compose.monitoring.yaml. Grafana listens on 127.0.0.1 only; reach it with an SSH tunnel
# (ssh -L 3000:127.0.0.1:3000 you@server) or put it behind Caddy yourself.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=1GB
LOKI_RETENTION=168h
PROMETHEUS_MEMORY=384m
GRAFANA_MEMORY=384m
LOKI_MEMORY=256m
ALLOY_MEMORY=192m

# scripts/backup.sh: where copies go, how many are kept, and an optional rclone remote for an
# off-site copy (for example "myremote:tetrizz-backups"). Relative paths start at this folder.
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_RCLONE_REMOTE=

# Optional, baked into the page at build time (docs/DEPLOYMENT.md). Leave empty for the room server alone.
TETRIZZ_SUPABASE_URL=
TETRIZZ_SUPABASE_KEY=
TETRIZZ_MQTT_BROKERS=
