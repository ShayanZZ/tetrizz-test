# Optional headers for Cloudflare Pages (docs/DEPLOYMENT.md): copy this file next to the built
# page, as the build command there does. The same values as the VPS stack's Caddyfile.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
