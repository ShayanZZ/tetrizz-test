    {
      "type": "timeseries",
      "title": "Refused per minute, by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(tetrizz_connections_refused_total[5m])) * 60",
