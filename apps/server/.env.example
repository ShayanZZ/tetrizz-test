# Settings of the own server (apps/server). Set them in the environment that starts the server;
# nothing here is secret and nothing is read from a file by the server itself.
# Every line shows the default. A value that is set but wrong stops the start with a list of
# what is wrong. docs/SERVER.md explains each one.

# Where to listen. Behind a reverse proxy on the same machine keep 127.0.0.1; in a container use 0.0.0.0.
HOST=127.0.0.1
PORT=8787

# Pages that may open a socket. Comma-separated origins (scheme and host, no path).
# A page served from the same host the socket is opened on is always allowed unless ALLOW_SAME_ORIGIN=false.
ALLOWED_ORIGINS=
ALLOW_SAME_ORIGIN=true
# The single-file build opened from disk sends the origin "null". Off unless you want that.
ALLOW_FILE_ORIGIN=false
# A script that sends no Origin at all (curl, wscat). Browsers always send one.
ALLOW_MISSING_ORIGIN=false

# false, the number of reverse proxies in front of the server (1 for Caddy), or their addresses.
# Needed so limits count the visitor and not the proxy. Never "true".
TRUST_PROXY=false

# How long a dropped player's seat (and host role) is held, in seconds. 0 = no hold.
SEAT_GRACE_SECONDS=30

# Capacity and limits.
MAX_ROOMS=200
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=8
CONNECTS_PER_MINUTE_PER_IP=30
MESSAGES_PER_SECOND=30
MESSAGE_BURST=100
PASSWORD_CHECKS_PER_MINUTE=60

# Ping every N seconds; a socket that has not answered by the next round is cut.
HEARTBEAT_SECONDS=20

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# A summary line (connections, rooms, counters) every N seconds; 0 turns it off.
STATS_LOG_SECONDS=300
# How long a stop waits for pages to close before cutting them.
SHUTDOWN_GRACE_SECONDS=5

# What the server remembers about play. off = nothing (rooms only, no /api/v1); sqlite; postgres.
DB_DRIVER=off
# SQLite file (the folder is created).
SQLITE_PATH=./data/sqlite/tetrizz.db
# PostgreSQL address, only for DB_DRIVER=postgres. It holds a password: keep it out of the repository.
DATABASE_URL=
DB_SCHEMA=
DB_POOL_MAX=5

# How many days each kind of row is kept (daily rollups are kept for ever).
RETENTION_EVENTS_DAYS=30
RETENTION_GAMES_DAYS=180
RETENTION_SESSIONS_DAYS=180
# Soft ceiling for the database in megabytes; 0 = none. Over it, the janitor halves the retention
# (down to one day) until the database fits; at 80 % the owner is warned.
DB_MAX_MB=0

# Limits of /api/v1, per address (addresses are never stored).
TELEMETRY_REQUESTS_PER_MINUTE=30
NEW_PLAYERS_PER_HOUR_PER_IP=60

# Maintenance job: rolls days up, purges old rows, gives space back, checks DB_MAX_MB.
JANITOR=on
# How often today is rolled up, and how often the last days are rolled up again and old rows purged.
JANITOR_LIVE_SECONDS=300
JANITOR_SETTLE_MINUTES=60
# Days before today that are rolled up again every time (late uploads from offline pages).
JANITOR_LOOKBACK_DAYS=3
JANITOR_PURGE_BATCH=5000

# /metrics for Prometheus. off (no such address) or on. With a token only requests that send
# "Authorization: Bearer <token>" are answered; without one only requests that did not come through a proxy.
METRICS=off
METRICS_TOKEN=

# Messages to the owner (all optional). Both Telegram values are needed together. They are secrets:
# keep them out of the repository.
SERVER_NAME=TetriZZ server
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# UTC hour of the daily digest (0 to 23) or off.
NOTIFY_DIGEST_HOUR_UTC=7
# Event-loop delay (ms, 99th percentile over 10 s, twice in a row) that raises an alert; 0 = off.
NOTIFY_LAG_MS=500
# This many unexpected errors inside the window raise an alert; 0 = off.
NOTIFY_ERROR_SPIKE=20
NOTIFY_ERROR_WINDOW_SECONDS=300
# The least time between two messages of the same kind (held-back ones are counted in the next one).
NOTIFY_COOLDOWN_MINUTES=30
