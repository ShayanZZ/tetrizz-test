# Copy to .env.local (ignored by git). Every line is optional; see docs/DEPLOYMENT.md.
# With none of them set, online play uses the public MQTT relay.

# Supabase project and its PUBLISHABLE (anon) key. Both are needed for Supabase to be used.
# Never put a service-role or secret key here: these values end up in the built page.
TETRIZZ_SUPABASE_URL=
TETRIZZ_SUPABASE_KEY=

# Your own TetriZZ server, when the page is hosted somewhere other than the server.
TETRIZZ_SERVER_URL=

# Comma-separated wss:// brokers replacing the three public ones, or "off".
TETRIZZ_MQTT_BROKERS=
